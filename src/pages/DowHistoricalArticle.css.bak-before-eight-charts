
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;color:#192c3d;background:#f8fafb}*{box-sizing:border-box}body{margin:0}header{border-bottom:1px solid #e1e6e9;background:white}.nav{max-width:1400px;margin:auto;padding:22px 34px;display:flex;align-items:center;justify-content:space-between}.logo{font-size:20px;letter-spacing:-.7px;font-weight:800}.logo b{color:#2774a3}main{max-width:1400px;margin:auto;padding:54px 34px 100px}.eyebrow{font-size:12px;letter-spacing:2.1px;font-weight:800;color:#37738c;text-transform:uppercase}h1{font-family:Georgia,serif;font-size:clamp(36px,5vw,72px);letter-spacing:-2.3px;line-height:1.08;font-weight:500;max-width:1100px;margin:16px 0 22px}h2{font-family:Georgia,serif;font-size:clamp(26px,3vw,40px);font-weight:500;margin:0 0 10px}p{line-height:1.65;color:#536677;max-width:750px;font-size:17px}.lead{font-size:19px}.hero{padding-bottom:46px}.tags{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px}.tag{border:1px solid #dce5e9;padding:8px 12px;border-radius:30px;background:white;font-size:12px;color:#4a6473;font-weight:650}.panel{border:1px solid #e0e7eb;border-radius:19px;background:#fff;box-shadow:0 16px 42px rgba(19,42,59,.035);padding:30px;margin-bottom:44px}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:18px}.caption{font-size:12px;color:#74828b;line-height:1.6}.original{display:block;width:100%;height:auto;border-radius:8px}.chartwrap{overflow-x:auto}.chartwrap svg{width:100%;min-width:900px;height:auto;display:block}.chartwrap svg text{font-family:Inter,system-ui,sans-serif}.event-circle{cursor:pointer;outline:none}.event-circle:focus{stroke:#1b344a;stroke-width:4}.era{font-size:11px;fill:#456375;font-weight:700}.toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:20px 0}.toolbar input,.toolbar select{border:1px solid #d9e2e8;background:white;border-radius:10px;padding:12px 14px;font:inherit;color:#213d52;min-width:210px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.event{border:1px solid #e3e9ed;border-radius:12px;background:#fff;text-align:left;padding:18px;cursor:pointer;transition:box-shadow .2s,border-color .2s;min-height:158px}.event:hover,.event.active{border-color:#2e7aa8;box-shadow:0 6px 20px rgba(31,103,151,.12)}.event small{color:#718797;font-weight:700}.event strong{display:block;font-size:17px;line-height:1.3;margin:9px 0}.event span{font-size:13px;color:#5a6d79;line-height:1.55}.detail{border-left:4px solid #2675a6;background:#f1f7fb;padding:18px 24px;border-radius:6px;margin-top:20px;min-height:110px}.detail h3{margin:5px 0 7px;font-size:20px}.detail p{margin:0;font-size:15px}.source{font-size:13px;color:#637786;margin-top:24px}.source a{color:#266f9c}.btn{display:inline-block;text-decoration:none;background:#203d54;color:white;padding:12px 17px;border-radius:9px;font-size:13px;font-weight:700}.btn.alt{background:#eaf2f7;color:#225777}.summary{display:flex;gap:22px;flex-wrap:wrap;margin:22px 0 14px}.summary strong{font-size:22px;display:block}.summary span{font-size:12px;color:#697f8c}.line-key{display:flex;gap:20px;flex-wrap:wrap;font-size:13px;color:#587180;margin-top:6px}.line-key i{display:inline-block;width:26px;height:5px;background:#1267a1;vertical-align:middle;border-radius:5px;margin-right:6px}@media(max-width:950px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:20px}}@media(max-width:620px){main{padding:30px 16px 70px}.nav{padding:16px}.grid{grid-template-columns:1fr}.panel{padding:14px;border-radius:12px}.panel-head{display:block}.lead{font-size:16px}h1{letter-spacing:-1px}.event{min-height:0}}


.original-research{max-width:1100px;margin:68px auto 90px;padding:44px 42px;background:#fff;border:1px solid #e5e9f1;border-radius:24px;color:#152238}
.original-research .archive-eyebrow{font:700 12px/1.5 system-ui;letter-spacing:.16em;color:#3463a0}
.original-research h2{font-size:clamp(25px,3vw,38px);line-height:1.2;margin:20px 0}
.original-research .archive-note{font-size:16px;line-height:1.7;color:#51647e;border-left:4px solid #366fa9;padding:12px 20px;background:#f3f7fc}
.original-research .archive-body{font-size:18px;line-height:1.8;overflow-wrap:anywhere}
.original-research .archive-body p,.original-research .archive-body ol{margin:20px 0}
.original-research .archive-body h2{font-size:26px;margin:38px 0 12px}
.original-research .archive-body table{width:100%;border-collapse:collapse;display:block;overflow-x:auto;white-space:nowrap;font-size:15px}
.original-research .archive-body th,.original-research .archive-body td{border-bottom:1px solid #e4eaf1;padding:11px 15px;text-align:left}
@media(max-width:700px){.original-research{padding:24px 18px;margin:36px 12px}.original-research .archive-body{font-size:17px}}

/* Full-width React page refinements */
.tni-dow-react-root {width:100%;min-height:100vh;background:#f8fafb;color:#192c3d;font-family:Inter,ui-sans-serif,system-ui,sans-serif}
.tni-dow-react-root main {width:100%;max-width:1480px;margin:0 auto;padding:42px clamp(18px,4vw,60px) 90px}
.tni-dow-react-root .original-research {width:min(100% - 36px,1180px);max-width:1180px}
.tni-dow-react-root img {max-width:100%;height:auto}
@media(min-width:1100px){.tni-dow-react-root main{max-width:1540px}.tni-dow-react-root .original-research{max-width:1180px}}
@media(max-width:700px){.tni-dow-react-root main{padding:22px 16px 60px}.tni-dow-react-root .original-research{width:calc(100% - 24px);padding:24px 18px;margin:35px auto}}

.tni-dow-topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:18px clamp(18px,4vw,60px);background:#fff;border-bottom:1px solid #e1e6e9}.tni-dow-topbar a{font-weight:800;font-size:20px;color:#192c3d;text-decoration:none}.tni-dow-topbar span{font-size:12px;color:#60758c;letter-spacing:.04em}

/* Sectioned desktop article, each major section visually distinct */
.dow-section-nav{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 42px;padding:16px 0;border-top:1px solid #e3e8ee;border-bottom:1px solid #e3e8ee}
.dow-section-nav a{padding:11px 15px;border-radius:9px;background:#edf4f9;color:#234c67;font-size:14px;font-weight:700;text-decoration:none}
.tni-dow-react-root .original-research{width:100%;max-width:none;margin:0 0 82px;padding:clamp(24px,3vw,52px);scroll-margin-top:30px}
.tni-dow-react-root .original-research .archive-body{max-width:1040px;margin:0 auto;font-size:18px;line-height:1.8}
.tni-dow-react-root .original-research .archive-body p{max-width:920px;font-size:18px}
.dow-original-figure{margin:34px auto 52px;max-width:1040px;padding:16px;background:#f6f9fc;border:1px solid #e0e8f0;border-radius:14px}
.dow-original-figure img{width:100%;height:auto;display:block}
.dow-original-figure figcaption{margin-top:12px;font-size:14px;color:#60758a}
.tni-dow-react-root #century-chart,.tni-dow-react-root #decade{margin-bottom:82px;scroll-margin-top:30px;padding:clamp(22px,3vw,46px)}
.tni-dow-react-root #century-chart .original{width:100%;max-width:100%;height:auto}
.dow-sources-section{padding:clamp(24px,3vw,46px);border:1px solid #e0e7eb;border-radius:18px;background:white;scroll-margin-top:30px}
.dow-sources-section h2{margin-top:12px}
.dow-sources-section p{max-width:940px;font-size:17px;line-height:1.75}
@media(max-width:700px){.tni-dow-react-root .original-research{padding:20px 16px;margin-bottom:44px}.tni-dow-react-root #century-chart,.tni-dow-react-root #decade{margin-bottom:44px}.dow-section-nav a{font-size:13px}.tni-dow-react-root .original-research .archive-body p{font-size:16px}}
