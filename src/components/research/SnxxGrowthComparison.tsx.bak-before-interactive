import { useMemo, useState } from "react"
import data from "../../data/charts/snxxSndkGrowthComparison.json"

type Range = "ALL" | "6M" | "3M" | "1M"
type Point = { date: string; snxx: number; sndk: number }

const BLUE = "#087BFA"
const AMBER = "#F59E0B"
const money = (n: number) =>
  n.toLocaleString("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  })

export default function SnxxGrowthComparison() {
  const [range, setRange] = useState<Range>("ALL")
  const [selected, setSelected] = useState<number | null>(null)

  const points = useMemo(() => {
    const all = data.data as Point[]
    if (range === "ALL") return all
    const end = new Date(all[all.length - 1].date + "T00:00:00")
    const months = range === "6M" ? 6 : range === "3M" ? 3 : 1
    const cutoff = new Date(end)
    cutoff.setMonth(cutoff.getMonth() - months)
    return all.filter(p => new Date(p.date + "T00:00:00") >= cutoff)
  }, [range])

  const first = points[0]
  const last = points[points.length - 1]
  const active = points[selected !== null && selected < points.length ? selected : points.length - 1]

  const W = 900
  const H = 320
  const left = 12
  const right = 12
  const top = 20
  const bottom = 32
  const chartW = W - left - right
  const chartH = H - top - bottom

  const values = points.flatMap(p => [p.snxx, p.sndk])
  const min = Math.min(...values)
  const max = Math.max(...values)
  const pad = Math.max((max - min) * 0.12, 1)
  const low = min - pad
  const high = max + pad

  const x = (i: number) => left + i / Math.max(points.length - 1, 1) * chartW
  const y = (v: number) => top + (high - v) / (high - low) * chartH
  const line = (ticker: "snxx" | "sndk") =>
    points.map((p, i) => `${i === 0 ? "M" : "L"}${x(i).toFixed(2)},${y(p[ticker]).toFixed(2)}`).join(" ")

  const change = (ticker: "snxx" | "sndk") =>
    ((last[ticker] / first[ticker]) - 1) * 100

  return (
    <section aria-labelledby="snxx-growth-title" style={{ margin: "64px 0" }}>
      <p style={{ color: BLUE, fontSize: 12, fontWeight: 750, letterSpacing: ".12em" }}>
        04 / TNI QUANTITATIVE RESEARCH
      </p>
      <h2 id="snxx-growth-title" style={{ fontSize: "clamp(26px,4vw,38px)", letterSpacing: "-.035em" }}>
        Growth of $10,000: SNXX vs SNDK
      </h2>
      <p style={{ color: "#64748b", lineHeight: 1.75 }}>
        Compare hypothetical buy-and-hold investment values using synchronized daily closing prices.
        Both investments begin at $10,000 on January 27, 2026.
      </p>

      <div style={{ display: "flex", gap: 8, flexWrap: "wrap", margin: "24px 0" }}>
        {(["ALL", "6M", "3M", "1M"] as Range[]).map(r => (
          <button key={r} type="button" onClick={() => { setRange(r); setSelected(null) }}
            aria-pressed={range === r}
            style={{
              padding: "11px 17px", borderRadius: 12, cursor: "pointer",
              border: range === r ? `2px solid ${BLUE}` : "1px solid #cbd5e1",
              background: range === r ? "#eaf3ff" : "#fff",
              color: "#172033", fontWeight: 700, minHeight: 44,
            }}>
            {r === "ALL" ? "Full history" : r}
          </button>
        ))}
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(2,minmax(0,1fr))", gap: 12 }}>
        {([
          ["SNXX", "snxx", BLUE],
          ["SNDK", "sndk", AMBER],
        ] as const).map(([name, ticker, color]) => (
          <div key={ticker} style={{ border: "1px solid #e2e8f0", borderRadius: 16, padding: 16, minWidth: 0 }}>
            <div style={{ fontWeight: 800, color }}>{name}</div>
            <div style={{ fontSize: "clamp(19px,3vw,28px)", fontWeight: 800, overflowWrap: "anywhere" }}>
              {money(active[ticker])}
            </div>
            <div style={{ fontSize: 13, color: change(ticker) >= 0 ? "#15803d" : "#dc2626" }}>
              {change(ticker) >= 0 ? "+" : ""}{change(ticker).toFixed(2)}% in selected range
            </div>
          </div>
        ))}
      </div>

      <div style={{ marginTop: 22, border: "1px solid #e2e8f0", borderRadius: 18, padding: "12px 8px 4px" }}>
        <svg viewBox={`0 0 ${W} ${H}`} width="100%" role="img"
          aria-label="Line chart comparing SNXX and SNDK hypothetical investment growth">
          {[0, .25, .5, .75, 1].map(f => {
            const yy = top + f * chartH
            return <line key={f} x1={left} x2={W - right} y1={yy} y2={yy}
              stroke="#e2e8f0" strokeDasharray="4 6" />
          })}
          <path d={line("snxx")} fill="none" stroke={BLUE} strokeWidth="4"
            strokeLinecap="round" strokeLinejoin="round" />
          <path d={line("sndk")} fill="none" stroke={AMBER} strokeWidth="4"
            strokeLinecap="round" strokeLinejoin="round" />
          {selected !== null && selected < points.length && (
            <line x1={x(selected)} x2={x(selected)} y1={top} y2={H - bottom}
              stroke="#64748b" strokeDasharray="5 5" />
          )}
          <rect x={left} y={top} width={chartW} height={chartH}
            fill="transparent" style={{ cursor: "crosshair" }}
            onPointerMove={e => {
              const rect = e.currentTarget.getBoundingClientRect()
              const ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width))
              setSelected(Math.round(ratio * (points.length - 1)))
            }}
            onPointerLeave={() => setSelected(null)}
          />
          <text x={left} y={H - 7} fill="#64748b" fontSize="17">{first.date}</text>
          <text x={W - right} y={H - 7} fill="#64748b" fontSize="17" textAnchor="end">{last.date}</text>
        </svg>
        <p style={{ fontSize: 12, color: "#64748b", textAlign: "center", margin: "0 0 10px" }}>
          {active.date} · SNXX {money(active.snxx)} · SNDK {money(active.sndk)}
        </p>
      </div>

      <p style={{ color: "#64748b", fontSize: 13, lineHeight: 1.8 }}>
        Price-return comparison, not total return. Excludes distributions, transaction costs
        and investor taxes. The selected ranges retain original investment values rather than
        rebasing each period to $10,000. Daily 2× leverage does not imply 2× cumulative returns.
      </p>
    </section>
  )
}
